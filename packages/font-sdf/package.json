{
  "name": "@mapka/font-sdf",
  "version": "0.5.0",
  "description": "Creates signed distance fields out of OpenType/TrueType fonts",
  "license": "BSD-2-Clause",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mapka-dev/fonts.git"
  },
  "main": "./lib/index.js",
  "scripts": {
    "pbf": "pbf ./proto/glyphs.proto > ./src/glyphs.js"
  },
  "dependencies": {
    "@types/opentype.js": "^1.3.8",
    "opentype.js": "^1.3.4",
    "pbf": "^4.0.1",
    "rbush": "~1.3.2"
  },
  "files": [
    "src/",
    "lib/",
    "!**/__tests__/",
    "!lib/buildInfo.json"
  ],
  "devDependencies": {
    "@chyzwar/tsconfig": "^0.4.0",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
